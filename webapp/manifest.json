{
	"_version": "1.21.0",

	"sap.app": {
		"id": "pagoti.fabio.launchpad.jsx",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "${version}"
		},
		"sourceTemplate": {
			"id": "generator-ui5-ts-app",
			"version": "1.1.0"
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {

		"rootView": {
			"viewName": "module:pagoti/fabio/launchpad/jsx/view/App",
			"id": "app",
			"async": true
		},

		"dependencies": {
			"minUI5Version": "1.153.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {}
			}
		},

		"resources": {
			"css": [
				{
					"id": "bootstrap-icons",
					"uri": "thirdparty/bootstrap-icons/font/bootstrap-icons.css"
				},
				{
					"id": "custom-css",
					"uri": "style/style.css"
				}
			]
		},
		"handleValidation": true,

		"contentDensities": {
			"compact": true,
			"cozy": true
		},

		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "pagoti.fabio.launchpad.jsx.i18n.i18n",
					"supportedLocales": [
						"en"
					],
					"fallbackLocale": "en",
					"async": true
				}
			}
		},

		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"path": "pagoti.fabio.launchpad.jsx.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "main",
					"target": "main"
				}
			],
			"targets": {
				"main": {
					"id": "main",
					"name": "module:pagoti/fabio/launchpad/jsx/view/Main"
				}
			}
		}
	}
}
